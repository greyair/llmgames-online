# Copy to .env.development for manual setup, or use pnpm run setup.
# Public browser configuration only. Never put a secret in this file.
PUBLIC_SITE_URL=http://localhost:3000
# Local MCP uses the API origin; production normally uses the main site's origin.
PUBLIC_MCP_URL=http://localhost:6787/api/v1/mcp
# Cloudflare public testing key. Production requires your own site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
