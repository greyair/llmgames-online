# Public build configuration only. These values are visible to browsers.
# Copy to .env.production and replace the domain and real Turnstile public site key.
PUBLIC_SITE_URL=https://games.example.com
# Optional override. If omitted, the app uses PUBLIC_SITE_URL + /api/v1/mcp.
PUBLIC_MCP_URL=https://games.example.com/api/v1/mcp
VITE_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
