# Non-secret API Worker variable checklist.
# Set these in wrangler.json for local development or your ignored wrangler-prod.json.
# Keep secrets in .dev.vars locally and Wrangler secrets in production.
# Do not copy this to .env alongside .dev.vars; Wrangler ignores .env in that case.

GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Cloudflare Email Sending: onboard your sender domain before enabling real delivery.
EMAIL_FROM=noreply@example.com

# Hosted Jev calls are disabled until you configure your own budget and server key.
JEV_DAILY_CALL_LIMIT=0
JEV_USER_DAILY_CALL_LIMIT=0
# Version of the independent credential key used for new encrypted records.
JEV_CREDENTIAL_KEY_VERSION=v1
